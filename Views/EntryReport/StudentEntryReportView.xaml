<UserControl x:Class="ACGCET_Admin.Views.EntryReport.StudentEntryReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:ACGCET_Admin.ViewModels.EntryReport"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:StudentEntryReportViewModel}"
             d:DesignHeight="700" d:DesignWidth="1024">
    <Grid Background="Transparent" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Filters (Shared Layout) -->
        <Grid Grid.Row="0" Margin="0 0 0 16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <TextBlock Text="Course Level" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0 0 16 0" />
            <ComboBox Grid.Column="1" Margin="0 4"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}" Background="White"
                      ItemsSource="{Binding CourseLevels}"
                      SelectedItem="{Binding SelectedCourseLevel}"/>

            <TextBlock Grid.Column="3" Text="Program" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0 0 16 0"/>
            <ComboBox Grid.Column="4" Margin="0 4"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}" Background="White"
                      ItemsSource="{Binding Programs}"
                      SelectedItem="{Binding SelectedProgram}"
                      DisplayMemberPath="ProgramName"/>

            <StackPanel Grid.Column="6" Grid.RowSpan="2" VerticalAlignment="Center">
                <Button Content="View" Command="{Binding ViewCommand}" Style="{StaticResource PrimaryButton}" Width="100" Margin="0 0 0 10"/>
                <Button Content="Preview" Command="{Binding PreviewCommand}" Style="{StaticResource SubtleButton}" Width="100" Margin="0 0 0 10"/>
                <Button Content="Clear" Command="{Binding ClearCommand}" Style="{StaticResource SubtleButton}" Width="100" Margin="0 0 0 10"/>
                <Button Command="{Binding RefreshCommand}" Style="{StaticResource IconButton}" ToolTip="Refresh" HorizontalAlignment="Left">
                    <materialDesign:PackIcon Kind="Refresh" Width="14" Height="14"/>
                </Button>
            </StackPanel>

            <TextBlock Grid.Row="1" Text="Batch" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0 10 0 0"/>
            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0 10 0 0"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}" Background="White"
                      ItemsSource="{Binding Batches}"
                      SelectedItem="{Binding SelectedBatch}"
                      DisplayMemberPath="BatchName"/>

            <TextBlock Grid.Row="1" Grid.Column="3" Text="Section" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0 10 0 0"/>
            <ComboBox Grid.Row="1" Grid.Column="4" Margin="0 10 0 0"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}" Background="White"
                      ItemsSource="{Binding Sections}"
                      SelectedItem="{Binding SelectedSection}"
                      DisplayMemberPath="SectionName"/>
        </Grid>

        <!-- Search -->
        <Border Grid.Row="1" BorderBrush="#E4E4E7" BorderThickness="1 1 1 0" Padding="8 6" Margin="0 0 0 0">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Search:" VerticalAlignment="Center" Margin="0 0 8 0" FontWeight="SemiBold"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource SearchBox}" Width="280" HorizontalAlignment="Left"/>
            </DockPanel>
        </Border>

        <!-- DataGrid -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding ReportData}" AutoGenerateColumns="False" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ANo" Binding="{Binding AdmissionNo}"/>
                <DataGridTextColumn Header="RNo" Binding="{Binding RollNo}"/>
                <DataGridTextColumn Header="Reg. No" Binding="{Binding RegNo}"/>
                <DataGridTextColumn Header="Student Name" Binding="{Binding StudentName}"/>
                <DataGridTextColumn Header="Regulation" Binding="{Binding RegulationName}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
