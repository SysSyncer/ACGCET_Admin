<UserControl x:Class="ACGCET_Admin.Views.DataManagement.ManageCoursesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:ACGCET_Admin.ViewModels.DataManagement"
             d:DataContext="{d:DesignInstance Type=vm:ManageCoursesViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <StackPanel>
        <TextBlock Text="Manage Courses"
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="#09090B"
                Margin="0 0 0 18"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Background="White"
                    BorderThickness="1"
                    BorderBrush="#E4E4E7"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="Add New Course"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#09090B"
                            Margin="0 0 0 16"/>
                    <ComboBox ItemsSource="{Binding DegreeList}"
                            SelectedItem="{Binding SelectedDegree}"
                            DisplayMemberPath="DegreeName"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                            md:HintAssist.Hint="Degree"
                            Margin="0 0 0 12"/>
                    <ComboBox ItemsSource="{Binding ProgramList}"
                            SelectedItem="{Binding SelectedProgram}"
                            DisplayMemberPath="ProgramName"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                            md:HintAssist.Hint="Program (filtered by Degree)"
                            Margin="0 0 0 12"/>
                    <ComboBox ItemsSource="{Binding RegulationList}"
                            SelectedItem="{Binding SelectedRegulation}"
                            DisplayMemberPath="RegulationName"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                            md:HintAssist.Hint="Regulation"
                            Margin="0 0 0 12"/>
                    <TextBox Text="{Binding CourseName, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             md:HintAssist.Hint="Course Name"
                            Margin="0 0 0 12"/>
                    <TextBox Text="{Binding CourseCode, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             md:HintAssist.Hint="Course Code"
                            Margin="0 0 0 12"/>
                    <Grid Margin="0 0 0 12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                Text="{Binding DurationYears, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                md:HintAssist.Hint="Duration (Years)"/>
                        <TextBox Grid.Column="2"
                                Text="{Binding TotalSemesters, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                md:HintAssist.Hint="Total Semesters"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Save"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Width="100"/>
                        <Button Content="Clear"
                                Command="{Binding ClearCommand}"
                                Style="{StaticResource SubtleButton}"
                                Width="80"
                                Margin="8 0 0 0"/>
                        <Button Content="Delete"
                                Command="{Binding DeleteCommand}"
                                Style="{StaticResource DangerButton}"
                                Width="90"
                                Margin="8 0 0 0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="2"
                    Background="White"
                    BorderThickness="1"
                    BorderBrush="#E4E4E7">
                <DataGrid ItemsSource="{Binding Courses}"
                        SelectedItem="{Binding SelectedCourse}"
                          AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        IsReadOnly="True"
                        HeadersVisibility="Column"
                        BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"
                                Binding="{Binding CourseId}"
                                Width="50"/>
                        <DataGridTextColumn Header="Course"
                                Binding="{Binding CourseName}"
                                Width="*"/>
                        <DataGridTextColumn Header="Code"
                                Binding="{Binding CourseCode}"
                                Width="90"/>
                        <DataGridTextColumn Header="Degree"
                                Binding="{Binding Degree.DegreeName}"
                                Width="100"/>
                        <DataGridTextColumn Header="Program"
                                Binding="{Binding Program.ProgramName}"
                                Width="120"/>
                        <DataGridTextColumn Header="Years"
                                Binding="{Binding DurationYears}"
                                Width="60"/>
                        <DataGridTextColumn Header="Sems"
                                Binding="{Binding TotalSemesters}"
                                Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
