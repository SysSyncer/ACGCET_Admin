<UserControl x:Class="ACGCET_Admin.Views.DataManagement.ManagePaperFeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:ACGCET_Admin.ViewModels.DataManagement"
             d:DataContext="{d:DesignInstance Type=vm:ManagePaperFeesViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <StackPanel>
        <TextBlock Text="Manage Paper Fees"
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="#09090B"
                Margin="0 0 0 18"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Background="White"
                    BorderThickness="1"
                    BorderBrush="#E4E4E7"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="Add New Paper Fee"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#09090B"
                            Margin="0 0 0 16"/>
                    <ComboBox ItemsSource="{Binding PaperList}"
                            SelectedItem="{Binding SelectedPaper}"
                            DisplayMemberPath="PaperCode"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                            md:HintAssist.Hint="Paper"
                            Margin="0 0 0 12"/>
                    <ComboBox ItemsSource="{Binding ExamTypeList}"
                            SelectedItem="{Binding SelectedExamType}"
                            DisplayMemberPath="TypeName"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                            md:HintAssist.Hint="Exam Type"
                            Margin="0 0 0 12"/>
                    <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             md:HintAssist.Hint="Amount (₹)"
                            Margin="0 0 0 12"/>
                    <DatePicker SelectedDate="{Binding EffectiveFrom}"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                md:HintAssist.Hint="Effective From"
                            Margin="0 0 0 20"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Save"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Width="100"/>
                        <Button Content="Clear"
                                Command="{Binding ClearCommand}"
                                Style="{StaticResource SubtleButton}"
                                Width="80"
                                Margin="8 0 0 0"/>
                        <Button Content="Delete"
                                Command="{Binding DeleteCommand}"
                                Style="{StaticResource DangerButton}"
                                Width="90"
                                Margin="8 0 0 0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="2"
                    Background="White"
                    BorderThickness="1"
                    BorderBrush="#E4E4E7">
                <DataGrid ItemsSource="{Binding PaperFees}"
                        SelectedItem="{Binding SelectedPaperFee}"
                          AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        IsReadOnly="True"
                        HeadersVisibility="Column"
                        BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"
                                Binding="{Binding PaperFeeId}"
                                Width="50"/>
                        <DataGridTextColumn Header="Paper"
                                Binding="{Binding Paper.PaperCode}"
                                Width="100"/>
                        <DataGridTextColumn Header="Exam Type"
                                Binding="{Binding ExamType.TypeName}"
                                Width="120"/>
                        <DataGridTextColumn Header="Amount"
                                Binding="{Binding Amount, StringFormat=₹{0:N2}}"
                                Width="100"/>
                        <DataGridTextColumn Header="Effective"
                                Binding="{Binding EffectiveFrom}"
                                Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
