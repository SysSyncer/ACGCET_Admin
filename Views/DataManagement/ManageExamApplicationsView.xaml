<UserControl x:Class="ACGCET_Admin.Views.DataManagement.ManageExamApplicationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:ACGCET_Admin.ViewModels.DataManagement"
             d:DataContext="{d:DesignInstance Type=vm:ManageExamApplicationsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <StackPanel>
        <TextBlock Text="Manage Exam Applications"
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="#09090B"
                Margin="0 0 0 18"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <!-- Student Search -->
                <Border Background="White"
                        BorderThickness="1"
                        BorderBrush="#E4E4E7"
                        Padding="20"
                        Margin="0 0 0 12">
                    <StackPanel>
                        <TextBlock Text="Create Exam Application"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#09090B"
                                Margin="0 0 0 14"/>
                        <Grid Margin="0 0 0 10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                    Text="{Binding SearchRegNo, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     md:HintAssist.Hint="Student Reg. No"/>
                            <Button Grid.Column="2"
                                    Content="Search"
                                    Command="{Binding SearchStudentCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    Height="38"/>
                        </Grid>
                        <TextBlock Margin="0 0 0 10"
                                FontSize="12"
                                Foreground="#52525B">
                            <Run Text="Found: "/><Run Text="{Binding SelectedStudent.FullName, FallbackValue='—'}"
                                    FontWeight="SemiBold"/>
                            <Run Text=" | "/><Run Text="{Binding SelectedStudent.Course.CourseName, FallbackValue=''}"/>
                        </TextBlock>

                        <ComboBox ItemsSource="{Binding ExaminationList}"
                                SelectedItem="{Binding SelectedExamination}"
                                DisplayMemberPath="ExamCode"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                md:HintAssist.Hint="Examination"
                                Margin="0 0 0 10"/>
                        <Grid Margin="0 0 0 10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                    Text="{Binding TotalFees, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     md:HintAssist.Hint="Total Fees"/>
                            <CheckBox Grid.Column="2"
                                    IsChecked="{Binding IsPaid}"
                                    Content="Paid"
                                    VerticalAlignment="Center"
                                    Margin="0 0 0 0"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Paper Selection -->
                <Border Background="White"
                        BorderThickness="1"
                        BorderBrush="#E4E4E7"
                        Padding="20"
                        Margin="0 0 0 12">
                    <StackPanel>
                        <TextBlock Text="Select Papers"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="#09090B"
                                Margin="0 0 0 8"/>
                        <DataGrid ItemsSource="{Binding PaperSelections}"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                BorderThickness="0"
                                MaxHeight="220">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="✓"
                                        Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                        Width="40"/>
                                <DataGridTextColumn Header="Code"
                                        Binding="{Binding PaperCode}"
                                        Width="90"
                                        IsReadOnly="True"/>
                                <DataGridTextColumn Header="Paper"
                                        Binding="{Binding PaperName}"
                                        Width="*"
                                        IsReadOnly="True"/>
                                <DataGridTextColumn Header="Sem"
                                        Binding="{Binding Semester}"
                                        Width="50"
                                        IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Create Application"
                            Command="{Binding SaveCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Width="160"/>
                    <Button Content="Clear"
                            Command="{Binding ClearCommand}"
                            Style="{StaticResource SubtleButton}"
                            Width="80"
                            Margin="8 0 0 0"/>
                    <Button Content="Delete"
                            Command="{Binding DeleteCommand}"
                            Style="{StaticResource DangerButton}"
                            Width="90"
                            Margin="8 0 0 0"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="2"
                    Background="White"
                    BorderThickness="1"
                    BorderBrush="#E4E4E7">
                <DataGrid ItemsSource="{Binding Applications}"
                        SelectedItem="{Binding SelectedApplication}"
                          AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        IsReadOnly="True"
                        HeadersVisibility="Column"
                        BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"
                                Binding="{Binding ExamApplicationId}"
                                Width="50"/>
                        <DataGridTextColumn Header="Student"
                                Binding="{Binding Student.FullName}"
                                Width="*"/>
                        <DataGridTextColumn Header="Reg No"
                                Binding="{Binding Student.RegistrationNumber}"
                                Width="120"/>
                        <DataGridTextColumn Header="Exam"
                                Binding="{Binding Examination.ExamCode}"
                                Width="110"/>
                        <DataGridTextColumn Header="Fees"
                                Binding="{Binding TotalFees, StringFormat=₹{0:N0}}"
                                Width="80"/>
                        <DataGridTextColumn Header="Status"
                                Binding="{Binding ApprovalStatus}"
                                Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
