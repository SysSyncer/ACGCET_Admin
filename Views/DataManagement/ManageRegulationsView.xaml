<UserControl x:Class="ACGCET_Admin.Views.DataManagement.ManageRegulationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:ACGCET_Admin.ViewModels.DataManagement"
             d:DataContext="{d:DesignInstance Type=vm:ManageRegulationsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <StackPanel>
        <TextBlock Text="Manage Regulations"
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="#09090B"
                Margin="0 0 0 18"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Background="White"
                    BorderThickness="1"
                    BorderBrush="#E4E4E7"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="Add New Regulation"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#09090B"
                            Margin="0 0 0 16"/>
                    <TextBox Text="{Binding RegulationYear, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             md:HintAssist.Hint="Regulation Year (e.g. 2021)"
                            Margin="0 0 0 12"/>
                    <TextBox Text="{Binding RegulationName, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             md:HintAssist.Hint="Regulation Name"
                            Margin="0 0 0 12"/>
                    <DatePicker SelectedDate="{Binding EffectiveFrom}"
                            Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                md:HintAssist.Hint="Effective From"
                            Margin="0 0 0 20"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Save"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Width="100"/>
                        <Button Content="Clear"
                                Command="{Binding ClearCommand}"
                                Style="{StaticResource SubtleButton}"
                                Width="80"
                                Margin="8 0 0 0"/>
                        <Button Content="Delete"
                                Command="{Binding DeleteCommand}"
                                Style="{StaticResource DangerButton}"
                                Width="90"
                                Margin="8 0 0 0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="2"
                    Background="White"
                    BorderThickness="1"
                    BorderBrush="#E4E4E7">
                <DataGrid ItemsSource="{Binding Regulations}"
                        SelectedItem="{Binding SelectedRegulation}"
                          AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        IsReadOnly="True"
                        HeadersVisibility="Column"
                        BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"
                                Binding="{Binding RegulationId}"
                                Width="50"/>
                        <DataGridTextColumn Header="Year"
                                Binding="{Binding RegulationYear}"
                                Width="80"/>
                        <DataGridTextColumn Header="Name"
                                Binding="{Binding RegulationName}"
                                Width="*"/>
                        <DataGridTextColumn Header="Effective"
                                Binding="{Binding EffectiveFrom}"
                                Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
