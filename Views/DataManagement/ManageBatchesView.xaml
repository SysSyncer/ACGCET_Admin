<UserControl x:Class="ACGCET_Admin.Views.DataManagement.ManageBatchesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:ACGCET_Admin.ViewModels.DataManagement"
             d:DataContext="{d:DesignInstance Type=vm:ManageBatchesViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <StackPanel>
        <TextBlock Text="Manage Batches"
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="#09090B"
                Margin="0 0 0 18"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Background="White"
                    BorderThickness="1"
                    BorderBrush="#E4E4E7"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="Add New Batch"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#09090B"
                            Margin="0 0 0 16"/>
                    <ComboBox ItemsSource="{Binding CourseList}"
                            SelectedItem="{Binding SelectedCourse}"
                            DisplayMemberPath="CourseName"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                            md:HintAssist.Hint="Course"
                            Margin="0 0 0 12"/>
                    <TextBox Text="{Binding BatchYear, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             md:HintAssist.Hint="Batch Year (e.g. 2024)"
                            Margin="0 0 0 12"/>
                    <TextBox Text="{Binding BatchName, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             md:HintAssist.Hint="Batch Name"
                            Margin="0 0 0 12"/>
                    <Grid Margin="0 0 0 12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <DatePicker Grid.Column="0"
                                SelectedDate="{Binding StartDate}"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                    md:HintAssist.Hint="Start Date"/>
                        <DatePicker Grid.Column="2"
                                SelectedDate="{Binding ExpectedEndDate}"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                    md:HintAssist.Hint="Expected End Date"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Save"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Width="100"/>
                        <Button Content="Clear"
                                Command="{Binding ClearCommand}"
                                Style="{StaticResource SubtleButton}"
                                Width="80"
                                Margin="8 0 0 0"/>
                        <Button Content="Delete"
                                Command="{Binding DeleteCommand}"
                                Style="{StaticResource DangerButton}"
                                Width="90"
                                Margin="8 0 0 0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="2"
                    Background="White"
                    BorderThickness="1"
                    BorderBrush="#E4E4E7">
                <DataGrid ItemsSource="{Binding Batches}"
                        SelectedItem="{Binding SelectedBatch}"
                          AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        IsReadOnly="True"
                        HeadersVisibility="Column"
                        BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"
                                Binding="{Binding BatchId}"
                                Width="50"/>
                        <DataGridTextColumn Header="Year"
                                Binding="{Binding BatchYear}"
                                Width="70"/>
                        <DataGridTextColumn Header="Name"
                                Binding="{Binding BatchName}"
                                Width="*"/>
                        <DataGridTextColumn Header="Course"
                                Binding="{Binding Course.CourseName}"
                                Width="150"/>
                        <DataGridTextColumn Header="Start"
                                Binding="{Binding StartDate}"
                                Width="100"/>
                        <DataGridTextColumn Header="End"
                                Binding="{Binding ExpectedEndDate}"
                                Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
