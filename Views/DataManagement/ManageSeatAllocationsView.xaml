<UserControl x:Class="ACGCET_Admin.Views.DataManagement.ManageSeatAllocationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:ACGCET_Admin.ViewModels.DataManagement"
             d:DataContext="{d:DesignInstance Type=vm:ManageSeatAllocationsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <StackPanel>
        <TextBlock Text="Manage Seat Allocations"
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="#09090B"
                Margin="0 0 0 18"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Background="White"
                    BorderThickness="1"
                    BorderBrush="#E4E4E7"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="Allocate Seat"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#09090B"
                            Margin="0 0 0 16"/>
                    <ComboBox ItemsSource="{Binding ScheduleList}"
                            SelectedItem="{Binding SelectedSchedule}"
                            DisplayMemberPath="ExamScheduleId"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                            md:HintAssist.Hint="Exam Schedule"
                            Margin="0 0 0 12"/>
                    <Grid Margin="0 0 0 10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                Text="{Binding SearchRegNo, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 md:HintAssist.Hint="Student Reg. No"/>
                        <Button Grid.Column="2"
                                Content="Search"
                                Command="{Binding SearchStudentCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Height="38"/>
                    </Grid>
                    <TextBlock Margin="0 0 0 10"
                            FontSize="12"
                            Foreground="#52525B">
                        <Run Text="Found: "/><Run Text="{Binding SelectedStudent.FullName, FallbackValue='—'}"
                                FontWeight="SemiBold"/>
                    </TextBlock>
                    <ComboBox ItemsSource="{Binding RoomList}"
                            SelectedItem="{Binding SelectedRoom}"
                            DisplayMemberPath="RoomNumber"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                            md:HintAssist.Hint="Room"
                            Margin="0 0 0 12"/>
                    <Grid Margin="0 0 0 12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                Text="{Binding SeatNumber, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 md:HintAssist.Hint="Seat #"/>
                        <TextBox Grid.Column="2"
                                Text="{Binding RowNumber, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 md:HintAssist.Hint="Row"/>
                        <TextBox Grid.Column="4"
                                Text="{Binding ColumnNumber, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 md:HintAssist.Hint="Col"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Allocate"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Width="110"/>
                        <Button Content="Clear"
                                Command="{Binding ClearCommand}"
                                Style="{StaticResource SubtleButton}"
                                Width="80"
                                Margin="8 0 0 0"/>
                        <Button Content="Delete"
                                Command="{Binding DeleteCommand}"
                                Style="{StaticResource DangerButton}"
                                Width="90"
                                Margin="8 0 0 0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="2"
                    Background="White"
                    BorderThickness="1"
                    BorderBrush="#E4E4E7">
                <DataGrid ItemsSource="{Binding Allocations}"
                        SelectedItem="{Binding SelectedAllocation}"
                          AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        IsReadOnly="True"
                        HeadersVisibility="Column"
                        BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"
                                Binding="{Binding SeatAllocationId}"
                                Width="50"/>
                        <DataGridTextColumn Header="Student"
                                Binding="{Binding Student.FullName}"
                                Width="*"/>
                        <DataGridTextColumn Header="Paper"
                                Binding="{Binding ExamSchedule.Paper.PaperCode}"
                                Width="90"/>
                        <DataGridTextColumn Header="Room"
                                Binding="{Binding Room.RoomNumber}"
                                Width="70"/>
                        <DataGridTextColumn Header="Seat"
                                Binding="{Binding SeatNumber}"
                                Width="50"/>
                        <DataGridTextColumn Header="Row"
                                Binding="{Binding RowNumber}"
                                Width="50"/>
                        <DataGridTextColumn Header="Col"
                                Binding="{Binding ColumnNumber}"
                                Width="50"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
