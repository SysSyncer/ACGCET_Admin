<UserControl x:Class="ACGCET_Admin.Views.DataManagement.ManageRoomsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:ACGCET_Admin.ViewModels.DataManagement"
             d:DataContext="{d:DesignInstance Type=vm:ManageRoomsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <StackPanel>
        <TextBlock Text="Manage Rooms"
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="#09090B"
                Margin="0 0 0 18"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Background="White"
                    BorderThickness="1"
                    BorderBrush="#E4E4E7"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="Add New Room"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#09090B"
                            Margin="0 0 0 16"/>
                    <TextBox Text="{Binding RoomNumber, UpdateSourceTrigger=PropertyChanged}"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             md:HintAssist.Hint="Room Number *"
                            Margin="0 0 0 12"/>
                    <ComboBox ItemsSource="{Binding BlockList}"
                            SelectedItem="{Binding SelectedBlock}"
                            DisplayMemberPath="BlockName"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                            md:HintAssist.Hint="Block"
                            Margin="0 0 0 12"/>
                    <Grid Margin="0 0 0 12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                Text="{Binding FloorNumber, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 md:HintAssist.Hint="Floor"/>
                        <TextBox Grid.Column="2"
                                Text="{Binding TotalCapacity, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 md:HintAssist.Hint="Capacity"/>
                    </Grid>
                    <Grid Margin="0 0 0 12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                Text="{Binding RowCount, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 md:HintAssist.Hint="Rows"/>
                        <TextBox Grid.Column="2"
                                Text="{Binding ColumnCount, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 md:HintAssist.Hint="Columns"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Save"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Width="100"/>
                        <Button Content="Clear"
                                Command="{Binding ClearCommand}"
                                Style="{StaticResource SubtleButton}"
                                Width="80"
                                Margin="8 0 0 0"/>
                        <Button Content="Delete"
                                Command="{Binding DeleteCommand}"
                                Style="{StaticResource DangerButton}"
                                Width="90"
                                Margin="8 0 0 0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="2"
                    Background="White"
                    BorderThickness="1"
                    BorderBrush="#E4E4E7">
                <DataGrid ItemsSource="{Binding Rooms}"
                        SelectedItem="{Binding SelectedRoom}"
                          AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        IsReadOnly="True"
                        HeadersVisibility="Column"
                        BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"
                                Binding="{Binding RoomId}"
                                Width="50"/>
                        <DataGridTextColumn Header="Room"
                                Binding="{Binding RoomNumber}"
                                Width="90"/>
                        <DataGridTextColumn Header="Block"
                                Binding="{Binding Block.BlockName}"
                                Width="100"/>
                        <DataGridTextColumn Header="Floor"
                                Binding="{Binding FloorNumber}"
                                Width="60"/>
                        <DataGridTextColumn Header="Capacity"
                                Binding="{Binding TotalCapacity}"
                                Width="80"/>
                        <DataGridTextColumn Header="Rows"
                                Binding="{Binding RowCount}"
                                Width="60"/>
                        <DataGridTextColumn Header="Cols"
                                Binding="{Binding ColumnCount}"
                                Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
