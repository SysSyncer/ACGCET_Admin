<UserControl x:Class="ACGCET_Admin.Views.DataManagement.ManageInternalMarksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:ACGCET_Admin.ViewModels.DataManagement"
             d:DataContext="{d:DesignInstance Type=vm:ManageInternalMarksViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    <StackPanel>
        <TextBlock Text="Manage Internal Marks"
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="#09090B"
                Margin="0 0 0 18"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Background="White"
                    BorderThickness="1"
                    BorderBrush="#E4E4E7"
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="Enter Internal Mark"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#09090B"
                            Margin="0 0 0 14"/>
                    <!-- Student Search -->
                    <Grid Margin="0 0 0 10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                Text="{Binding SearchRegNo, UpdateSourceTrigger=PropertyChanged}"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 md:HintAssist.Hint="Student Reg. No"/>
                        <Button Grid.Column="2"
                                Content="Search"
                                Command="{Binding SearchStudentCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Height="38"/>
                    </Grid>
                    <TextBlock Margin="0 0 0 10"
                            FontSize="12"
                            Foreground="#52525B">
                        <Run Text="Student: "/><Run Text="{Binding FoundStudent.FullName, FallbackValue='—'}"
                                FontWeight="SemiBold"/>
                    </TextBlock>

                    <ComboBox ItemsSource="{Binding PaperList}"
                            SelectedItem="{Binding SelectedPaper}"
                            DisplayMemberPath="PaperCode"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                            md:HintAssist.Hint="Paper"
                            Margin="0 0 0 12"/>
                    <ComboBox ItemsSource="{Binding TestTypeList}"
                            SelectedItem="{Binding SelectedTestType}"
                            DisplayMemberPath="TestName"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                            md:HintAssist.Hint="Test Type"
                            Margin="0 0 0 12"/>
                    <TextBox Text="{Binding Semester, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                            Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             md:HintAssist.Hint="Semester"
                            Margin="0 0 0 12"/>
                    <Grid Margin="0 0 0 16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                Text="{Binding Mark, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 md:HintAssist.Hint="Mark"/>
                        <TextBox Grid.Column="2"
                                Text="{Binding MaxMark, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 md:HintAssist.Hint="Max Mark"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Save"
                                Command="{Binding SaveCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Width="100"/>
                        <Button Content="Clear"
                                Command="{Binding ClearCommand}"
                                Style="{StaticResource SubtleButton}"
                                Width="80"
                                Margin="8 0 0 0"/>
                        <Button Content="Delete"
                                Command="{Binding DeleteCommand}"
                                Style="{StaticResource DangerButton}"
                                Width="90"
                                Margin="8 0 0 0"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="2"
                    Background="White"
                    BorderThickness="1"
                    BorderBrush="#E4E4E7">
                <DataGrid ItemsSource="{Binding InternalMarks}"
                        SelectedItem="{Binding SelectedInternalMark}"
                          AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        IsReadOnly="True"
                        HeadersVisibility="Column"
                        BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"
                                Binding="{Binding InternalMarkId}"
                                Width="50"/>
                        <DataGridTextColumn Header="Student"
                                Binding="{Binding Student.FullName}"
                                Width="*"/>
                        <DataGridTextColumn Header="Paper"
                                Binding="{Binding Paper.PaperCode}"
                                Width="90"/>
                        <DataGridTextColumn Header="Test"
                                Binding="{Binding TestType.TestName}"
                                Width="90"/>
                        <DataGridTextColumn Header="Sem"
                                Binding="{Binding Semester}"
                                Width="50"/>
                        <DataGridTextColumn Header="Mark"
                                Binding="{Binding Mark}"
                                Width="60"/>
                        <DataGridTextColumn Header="Max"
                                Binding="{Binding MaxMark}"
                                Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
