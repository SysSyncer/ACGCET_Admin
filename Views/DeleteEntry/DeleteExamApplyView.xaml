<UserControl x:Class="ACGCET_Admin.Views.DeleteEntry.DeleteExamApplyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:ACGCET_Admin.ViewModels.DeleteEntry"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodels:DeleteExamApplyViewModel}"
             d:DesignHeight="700" d:DesignWidth="1024">

    <Grid Background="Transparent" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- filter form -->
            <RowDefinition Height="Auto"/>  <!-- action buttons -->
            <RowDefinition Height="*"/>     <!-- data grid -->
        </Grid.RowDefinitions>

        <!-- Row 0: Filter Form -->
        <Grid Grid.Row="0" Margin="0 0 0 8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Exam Session" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <ComboBox Grid.Row="0" Grid.Column="1" Margin="0 4"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}" Background="White"
                      ItemsSource="{Binding ExamSessions}"
                      SelectedItem="{Binding SelectedSession}"
                      DisplayMemberPath="SessionName"/>

            <TextBlock Grid.Row="0" Grid.Column="3" Text="Reg No" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBox   Grid.Row="0" Grid.Column="4" Text="{Binding RegNo, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Admission No" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding AdmissionNo}" IsReadOnly="True"/>

            <TextBlock Grid.Row="1" Grid.Column="3" Text="Roll No" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBox   Grid.Row="1" Grid.Column="4" Text="{Binding RollNo}" IsReadOnly="True"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Student Name" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding StudentName}" IsReadOnly="True"/>

            <TextBlock Grid.Row="2" Grid.Column="3" Text="Program" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBox   Grid.Row="2" Grid.Column="4" Text="{Binding ProgramName}" IsReadOnly="True"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Batch" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBox   Grid.Row="3" Grid.Column="1" Text="{Binding Batch}" IsReadOnly="True"/>

            <TextBlock Grid.Row="3" Grid.Column="3" Text="Section" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBox   Grid.Row="3" Grid.Column="4" Text="{Binding Section}" IsReadOnly="True"/>
        </Grid>

        <!-- Row 1: Action Buttons -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0 0 0 12">
            <Button Content="VIEW"   Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButton}" Margin="0 0 8 0"/>
            <Button Content="DELETE" Command="{Binding DeleteCommand}" Style="{StaticResource DangerButton}"  Margin="0 0 8 0"/>
            <Button Content="CLEAR"  Command="{Binding ClearCommand}"  Style="{StaticResource SubtleButton}"  Margin="0 0 8 0"/>
            <Button Command="{Binding RefreshCommand}" Style="{StaticResource IconButton}" ToolTip="Refresh">
                <md:PackIcon Kind="Refresh" Width="14" Height="14"/>
            </Button>
        </StackPanel>

        <!-- Row 2: DataGrid -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding PaperList}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Subject Code" Binding="{Binding PaperCode}" IsReadOnly="True" Width="160"/>
                <DataGridTextColumn Header="Subject Name" Binding="{Binding PaperName}" IsReadOnly="True" Width="*"/>
                <DataGridCheckBoxColumn Header="Select"   Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
