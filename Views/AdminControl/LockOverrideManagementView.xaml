<UserControl x:Class="ACGCET_Admin.Views.AdminControl.LockOverrideManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:ACGCET_Admin.ViewModels.AdminControl"
             d:DataContext="{d:DesignInstance Type=vm:LockOverrideManagementViewModel}"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0 0 0 14">
            <md:PackIcon Kind="LockOpenVariant" Width="26" Height="26"
                         Foreground="#E65100" VerticalAlignment="Center" Margin="0 0 10 0"/>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Lock Override Requests" FontSize="20" FontWeight="Bold" Foreground="#E65100"/>
                <TextBlock Text="Manage faculty requests for temporary module unlock"
                           FontSize="11" Foreground="#9E9E9E"/>
            </StackPanel>
        </StackPanel>

        <!-- Filter Bar -->
        <Grid Grid.Row="1" Margin="0 0 0 12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ComboBox Grid.Column="0" ItemsSource="{Binding StatusOptions}"
                      SelectedItem="{Binding FilterStatus}"
                      md:HintAssist.Hint="Filter by Status"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      Background="White" Margin="0 0 10 0"/>
            <Button Grid.Column="1" Command="{Binding LoadRequestsCommand}"
                    Style="{StaticResource MaterialDesignFlatAccentBgButton}"
                    Background="#E65100" Foreground="White" BorderBrush="#E65100" Height="40">
                <StackPanel Orientation="Horizontal">
                    <md:PackIcon Kind="Refresh" VerticalAlignment="Center" Margin="0 0 6 0"/>
                    <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <TextBlock Grid.Column="2" Text="{Binding StatusMessage}" Foreground="{Binding StatusColor}"
                       FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>

        <!-- Requests Grid -->
        <md:Card Grid.Row="2" ClipToBounds="True" Background="White" Margin="0 0 0 12">
            <Grid>
                <Border Panel.ZIndex="10" Background="#F5F5F5"
                        Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                     IsIndeterminate="True" Value="0" Width="44" Height="44"/>
                        <TextBlock Text="Loading..." Foreground="#E65100" FontSize="13"
                                   HorizontalAlignment="Center" Margin="0 12 0 0"/>
                    </StackPanel>
                </Border>

                <DataGrid ItemsSource="{Binding Requests}"
                          SelectedItem="{Binding SelectedRequest}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column"
                          Style="{StaticResource MaterialDesignDataGrid}"
                          Visibility="{Binding HasRequests, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Width="50" Binding="{Binding RequestId}"/>
                        <DataGridTextColumn Header="Requested By" Width="150" Binding="{Binding RequestedByUser}"/>
                        <DataGridTextColumn Header="Module" Width="140" Binding="{Binding ModuleName}"/>
                        <DataGridTextColumn Header="Reason" Width="*" Binding="{Binding RequestReason}"/>
                        <DataGridTextColumn Header="Status" Width="80" Binding="{Binding ApprovalStatus}"/>
                        <DataGridTextColumn Header="Date" Width="140"
                            Binding="{Binding RequestedDateTime, StringFormat='{}{0:dd-MMM-yyyy HH:mm}'}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasRequests, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <md:PackIcon Kind="LockOpenVariantOutline" Width="64" Height="64"
                                 Foreground="#BDBDBD" HorizontalAlignment="Center"/>
                    <TextBlock Text="No override requests found" Foreground="#9E9E9E"
                               FontSize="14" HorizontalAlignment="Center" Margin="0 12 0 0"/>
                </StackPanel>
            </Grid>
        </md:Card>

        <!-- Action Bar -->
        <md:Card Grid.Row="3" Padding="16 12" Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Text="{Binding ApprovalComments, UpdateSourceTrigger=PropertyChanged}"
                         md:HintAssist.Hint="Comments (optional)"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Background="White" Margin="0 0 12 0"/>

                <TextBox Grid.Column="1"
                         Text="{Binding UnlockDurationMinutes, UpdateSourceTrigger=PropertyChanged}"
                         md:HintAssist.Hint="Duration (min)"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         Background="White" Margin="0 0 12 0"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="APPROVE &amp; UNLOCK" Command="{Binding ApproveAndUnlockCommand}"
                            Style="{StaticResource MaterialDesignFlatAccentBgButton}"
                            Background="#4CAF50" Foreground="White" BorderBrush="#4CAF50"
                            Margin="0 0 8 0"/>
                    <Button Content="REJECT" Command="{Binding RejectRequestCommand}"
                            Style="{StaticResource MaterialDesignFlatAccentBgButton}"
                            Background="#F44336" Foreground="White" BorderBrush="#F44336"/>
                </StackPanel>
            </Grid>
        </md:Card>
    </Grid>
</UserControl>
