<UserControl x:Class="ACGCET_Admin.Views.AdminControl.EntryProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:ACGCET_Admin.ViewModels.AdminControl"
             d:DataContext="{d:DesignInstance Type=vm:EntryProgressViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="900">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0 0 0 12">
            <TextBlock Text="Data Entry Progress" FontSize="20" FontWeight="Bold" Foreground="#7C3AED"
                       VerticalAlignment="Center"/>
            <TextBlock Text="{Binding ExamLabel, StringFormat=' — {0}'}" FontSize="14"
                       Foreground="#71717A" VerticalAlignment="Center" Margin="8 2 0 0"/>
            <Button Content="Refresh" Command="{Binding LoadCommand}"
                    Style="{StaticResource MaterialDesignOutlinedButton}" Margin="16 0 0 0"
                    VerticalAlignment="Center"/>
        </StackPanel>

        <!-- KPI Summary -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="0 0 0 16">
            <md:Card Padding="14" Margin="0 0 8 0" md:ElevationAssist.Elevation="Dp1">
                <StackPanel>
                    <TextBlock Text="Total Applied" FontSize="11" Foreground="#71717A"/>
                    <TextBlock Text="{Binding TotalApplied}" FontSize="24" FontWeight="Bold" Foreground="#7C3AED"/>
                </StackPanel>
            </md:Card>
            <md:Card Padding="14" Margin="4 0" md:ElevationAssist.Elevation="Dp1">
                <StackPanel>
                    <TextBlock Text="Internal Entered" FontSize="11" Foreground="#71717A"/>
                    <TextBlock Text="{Binding InternalEntered}" FontSize="24" FontWeight="Bold" Foreground="#2563EB"/>
                </StackPanel>
            </md:Card>
            <md:Card Padding="14" Margin="4 0" md:ElevationAssist.Elevation="Dp1">
                <StackPanel>
                    <TextBlock Text="External Entered" FontSize="11" Foreground="#71717A"/>
                    <TextBlock Text="{Binding ExternalEntered}" FontSize="24" FontWeight="Bold" Foreground="#16A34A"/>
                </StackPanel>
            </md:Card>
            <md:Card Padding="14" Margin="8 0 0 0" md:ElevationAssist.Elevation="Dp1">
                <StackPanel>
                    <TextBlock Text="Results Published" FontSize="11" Foreground="#71717A"/>
                    <TextBlock Text="{Binding ResultsPublished}" FontSize="24" FontWeight="Bold" Foreground="#EA580C"/>
                </StackPanel>
            </md:Card>
        </UniformGrid>

        <!-- Search -->
        <Border Grid.Row="2" BorderBrush="#E4E4E7" BorderThickness="1" Padding="8 6" Margin="0 0 0 10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Search:" VerticalAlignment="Center" Margin="0 0 8 0" FontWeight="SemiBold"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource SearchBox}" Width="280" HorizontalAlignment="Left"/>
            </DockPanel>
        </Border>

        <!-- Department Stats Label -->
        <TextBlock Grid.Row="3" Text="Department-wise Progress" FontSize="14" FontWeight="SemiBold"
                   Foreground="#18181B" Margin="0 0 0 6"/>

        <!-- Department DataGrid -->
        <DataGrid Grid.Row="4" ItemsSource="{Binding DepartmentStats}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  Style="{StaticResource MaterialDesignDataGrid}"
                  md:DataGridAssist.CellPadding="8 4" Margin="0 0 0 16">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="*"/>
                <DataGridTextColumn Header="Total" Binding="{Binding TotalEntries}" Width="70"/>
                <DataGridTextColumn Header="Int Done" Binding="{Binding InternalDone}" Width="70"/>
                <DataGridTextColumn Header="Int %" Binding="{Binding InternalPercent}" Width="60"/>
                <DataGridTextColumn Header="Ext Done" Binding="{Binding ExternalDone}" Width="70"/>
                <DataGridTextColumn Header="Ext %" Binding="{Binding ExternalPercent}" Width="60"/>
                <DataGridTextColumn Header="Results" Binding="{Binding ResultsDone}" Width="70"/>
                <DataGridTextColumn Header="Res %" Binding="{Binding ResultsPercent}" Width="60"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Paper Stats Label -->
        <TextBlock Grid.Row="5" Text="Paper-wise Progress" FontSize="14" FontWeight="SemiBold"
                   Foreground="#18181B" Margin="0 0 0 6"/>

        <!-- Paper DataGrid -->
        <DataGrid Grid.Row="6" ItemsSource="{Binding PaperStats}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  Style="{StaticResource MaterialDesignDataGrid}"
                  md:DataGridAssist.CellPadding="8 4">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Paper Code" Binding="{Binding PaperCode}" Width="120"/>
                <DataGridTextColumn Header="Students" Binding="{Binding TotalStudents}" Width="80"/>
                <DataGridTextColumn Header="Int Done" Binding="{Binding InternalDone}" Width="80"/>
                <DataGridTextColumn Header="Int Pending" Binding="{Binding InternalPending}" Width="90"/>
                <DataGridTextColumn Header="Ext Done" Binding="{Binding ExternalDone}" Width="80"/>
                <DataGridTextColumn Header="Ext Pending" Binding="{Binding ExternalPending}" Width="90"/>
                <DataGridTextColumn Header="Results" Binding="{Binding ResultsDone}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
