<Application x:Class="ACGCET_Admin.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ACGCET_Admin"
             xmlns:converters="clr-namespace:ACGCET_Admin.Converters"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <md:BundledTheme BaseTheme="Light" PrimaryColor="DeepPurple" SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ══ CONVERTERS ═══════════════════════════════════════ -->
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:InverseBoolToVisibilityConverter  x:Key="InverseBoolToVisibilityConverter"/>
            <converters:InverseBooleanConverter           x:Key="InverseBooleanConverter"/>
            <converters:SeverityToBackgroundConverter     x:Key="SeverityToBgConverter"/>
            <converters:SeverityToForegroundConverter     x:Key="SeverityToFgConverter"/>
            <converters:ActionTypeToBackgroundConverter   x:Key="ActionTypeToBgConverter"/>
            <converters:ActionTypeToForegroundConverter   x:Key="ActionTypeToFgConverter"/>
            <converters:LockToBackgroundConverter         x:Key="LockToBgConverter"/>
            <converters:LockToForegroundConverter         x:Key="LockToFgConverter"/>

            <!-- ══ DESIGN TOKENS ════════════════════════════════════ -->
            <SolidColorBrush x:Key="PrimaryBrush"      Color="#7C3AED"/>
            <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#6D28D9"/>
            <SolidColorBrush x:Key="PrimaryLightBrush" Color="#EDE9FE"/>
            <SolidColorBrush x:Key="PrimaryFaintBrush" Color="#F5F3FF"/>
            <SolidColorBrush x:Key="PrimaryTextBrush"  Color="#5B21B6"/>
            <SolidColorBrush x:Key="AppFgBrush"        Color="#09090B"/>
            <SolidColorBrush x:Key="AppMutedBrush"     Color="#71717A"/>
            <SolidColorBrush x:Key="AppBorderBrush"    Color="#E4E4E7"/>
            <SolidColorBrush x:Key="AppBgBrush"        Color="#FAFAFA"/>
            <SolidColorBrush x:Key="AppCardBrush"      Color="#FFFFFF"/>
            <SolidColorBrush x:Key="AppSubtleBrush"    Color="#F4F4F5"/>
            <SolidColorBrush x:Key="DestructiveBrush"  Color="#EF4444"/>
            <SolidColorBrush x:Key="SuccessBrush"      Color="#22C55E"/>
            <SolidColorBrush x:Key="WarningBrush"      Color="#F97316"/>

            <!-- ══ FONT ══════════════════════════════════════════════ -->
            <!-- Google Sans → falls back to Segoe UI Variable Display on machines without it -->
            <FontFamily x:Key="AppFont">pack://application:,,,/Resources/Fonts/#Google Sans,Google Sans,Segoe UI Variable Display,Segoe UI</FontFamily>

            <!-- ══ GLOBAL FONT — applied to all text-bearing controls ══ -->
            <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignBody2TextBlock}">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            </Style>
            <Style TargetType="Label">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                <Setter Property="FontSize"   Value="13"/>
                <Setter Property="Foreground" Value="{StaticResource AppFgBrush}"/>
            </Style>

            <!-- ══ TEXTBOX — MD outlined + font override ════════ -->
            <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                <Setter Property="FontSize"   Value="13"/>
                <Setter Property="Margin"     Value="0 4"/>
            </Style>

            <!-- ══ COMBOBOX — fully custom, sharp edges, white bg ══ -->
            <!-- Toggle button template (the clickable area with chevron) -->
            <ControlTemplate x:Key="AppComboToggle" TargetType="ToggleButton">
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M 0 0 L 5 4 L 10 0" Stroke="#71717A" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="BorderBrush" Value="#7C3AED"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter Property="BorderBrush" Value="#7C3AED"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <!-- ComboBoxItem style -->
            <Style TargetType="ComboBoxItem">
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="FontFamily"  Value="{StaticResource AppFont}"/>
                <Setter Property="FontSize"    Value="13"/>
                <Setter Property="Foreground"  Value="#09090B"/>
                <Setter Property="Padding"     Value="12 8"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Bd" Background="White"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#F5F3FF"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#EDE9FE"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="#A1A1AA"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ComboBox style -->
            <Style TargetType="ComboBox">
                <Setter Property="OverridesDefaultStyle"    Value="True"/>
                <Setter Property="SnapsToDevicePixels"      Value="True"/>
                <Setter Property="Background"               Value="White"/>
                <Setter Property="BorderBrush"              Value="#E4E4E7"/>
                <Setter Property="BorderThickness"          Value="1"/>
                <Setter Property="Foreground"               Value="#09090B"/>
                <Setter Property="FontFamily"               Value="{StaticResource AppFont}"/>
                <Setter Property="FontSize"                 Value="13"/>
                <Setter Property="Height"                   Value="36"/>
                <Setter Property="Margin"                   Value="0 4"/>
                <Setter Property="MaxDropDownHeight"        Value="220"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility"   Value="Auto"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="ToggleButton"
                                              Template="{StaticResource AppComboToggle}"
                                              Background="{TemplateBinding Background}"
                                              BorderBrush="{TemplateBinding BorderBrush}"
                                              BorderThickness="{TemplateBinding BorderThickness}"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                          RelativeSource={RelativeSource TemplatedParent}}"
                                              Focusable="False" ClickMode="Press"/>
                                <!-- Placeholder "Select" — visible only when nothing is selected -->
                                <TextBlock x:Name="Placeholder"
                                           Text="Select"
                                           Foreground="#A1A1AA"
                                           Margin="12 0 28 0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"/>
                                <!-- Selected value display -->
                                <ContentPresenter x:Name="ContentSite"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  Margin="12 0 28 0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"/>
                                <Popup x:Name="Popup"
                                       Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="None">
                                    <Grid x:Name="DropDown"
                                          SnapsToDevicePixels="True"
                                          MinWidth="{TemplateBinding ActualWidth}"
                                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <Border x:Name="DropDownBorder"
                                                Background="White"
                                                BorderThickness="1"
                                                BorderBrush="#E4E4E7">
                                            <ScrollViewer Margin="0 4" SnapsToDevicePixels="True">
                                                <StackPanel IsItemsHost="True"
                                                            KeyboardNavigation.DirectionalNavigation="Contained"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- Show placeholder when nothing is selected -->
                                <Trigger Property="SelectedItem" Value="{x:Null}">
                                    <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="#A1A1AA"/>
                                    <Setter TargetName="ToggleButton" Property="BorderBrush" Value="#F4F4F5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ══ DATAGRID — MD base + our overrides ════════════════ -->
            <Style TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}">
                <Setter Property="BorderThickness"               Value="0"/>
                <Setter Property="RowBackground"                 Value="White"/>
                <Setter Property="AlternatingRowBackground"      Value="#F5F3FF"/>
                <Setter Property="GridLinesVisibility"           Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush"      Value="#EDE9FE"/>
                <Setter Property="HeadersVisibility"             Value="Column"/>
                <Setter Property="SelectionMode"                 Value="Single"/>
                <Setter Property="SelectionUnit"                 Value="FullRow"/>
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility"   Value="Auto"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
                <Setter Property="FontSize"                      Value="13"/>
                <Setter Property="FontFamily"                    Value="{StaticResource AppFont}"/>
                <Setter Property="RowHeight"                     Value="46"/>
                <Setter Property="CanUserReorderColumns"         Value="False"/>
                <Setter Property="CanUserResizeRows"             Value="False"/>
                <Setter Property="EnableRowVirtualization"       Value="True"/>
                <Setter Property="EnableColumnVirtualization"    Value="True"/>
            </Style>

            <Style TargetType="DataGridColumnHeader"
                   BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                <Setter Property="Background"               Value="#F5F3FF"/>
                <Setter Property="Foreground"               Value="#5B21B6"/>
                <Setter Property="FontWeight"               Value="SemiBold"/>
                <Setter Property="FontSize"                 Value="12"/>
                <Setter Property="FontFamily"               Value="{StaticResource AppFont}"/>
                <Setter Property="Padding"                  Value="12 9"/>
                <Setter Property="BorderBrush"              Value="#E4E4E7"/>
                <Setter Property="BorderThickness"          Value="0 0 0 1"/>
            </Style>

            <Style TargetType="DataGridRow"
                   BasedOn="{StaticResource MaterialDesignDataGridRow}">
                <Setter Property="FontSize"   Value="13"/>
                <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F5F3FF"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#EDE9FE"/>
                        <Setter Property="Foreground" Value="#09090B"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Cell padding — 16px left/right, content vertically centered -->
            <Style TargetType="DataGridCell">
                <Setter Property="BorderThickness"  Value="0"/>
                <Setter Property="FontFamily"       Value="{StaticResource AppFont}"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Background="{TemplateBinding Background}"
                                    BorderThickness="0"
                                    Padding="16 0">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background"  Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="Foreground"  Value="#09090B"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ══ SEARCH BOX style (reusable above any DataGrid) ═══════ -->
            <Style x:Key="SearchBox" TargetType="TextBox">
                <Setter Property="OverridesDefaultStyle" Value="True"/>
                <Setter Property="SnapsToDevicePixels"   Value="True"/>
                <Setter Property="FontFamily"  Value="{StaticResource AppFont}"/>
                <Setter Property="FontSize"    Value="13"/>
                <Setter Property="Foreground"  Value="#09090B"/>
                <Setter Property="Background"  Value="White"/>
                <Setter Property="BorderBrush" Value="#E4E4E7"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Height"      Value="34"/>
                <Setter Property="Padding"     Value="10 0"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Data="M 6 0 A 6 6 0 1 0 6 12 A 6 6 0 1 0 6 0 M 10 10 L 14 14"
                                          Stroke="#A1A1AA" StrokeThickness="1.5"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  Grid.Column="1"
                                                  VerticalAlignment="Center"
                                                  Focusable="False"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter Property="BorderBrush" Value="#7C3AED"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ══ NAMED BUTTON STYLES (sharp, smaller) ══════════════ -->
            <!-- Primary filled purple -->
            <Style x:Key="PrimaryButton" TargetType="Button"
                   BasedOn="{StaticResource MaterialDesignRaisedButton}">
                <Setter Property="Background"          Value="#7C3AED"/>
                <Setter Property="Foreground"          Value="White"/>
                <Setter Property="BorderThickness"     Value="0"/>
                <Setter Property="md:ButtonAssist.CornerRadius" Value="0"/>
                <Setter Property="md:ElevationAssist.Elevation" Value="Dp0"/>
                <Setter Property="FontSize"            Value="12"/>
                <Setter Property="FontWeight"          Value="Medium"/>
                <Setter Property="FontFamily"          Value="{StaticResource AppFont}"/>
                <Setter Property="Height"              Value="28"/>
                <Setter Property="Padding"             Value="14 0"/>
            </Style>

            <!-- Outlined purple -->
            <Style x:Key="OutlineButton" TargetType="Button"
                   BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                <Setter Property="BorderBrush"         Value="#7C3AED"/>
                <Setter Property="Foreground"          Value="#7C3AED"/>
                <Setter Property="BorderThickness"     Value="1"/>
                <Setter Property="md:ButtonAssist.CornerRadius" Value="0"/>
                <Setter Property="FontSize"            Value="12"/>
                <Setter Property="FontFamily"          Value="{StaticResource AppFont}"/>
                <Setter Property="Height"              Value="28"/>
                <Setter Property="Padding"             Value="14 0"/>
            </Style>

            <!-- Subtle outline (muted) -->
            <Style x:Key="SubtleButton" TargetType="Button"
                   BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                <Setter Property="BorderBrush"         Value="#E4E4E7"/>
                <Setter Property="Foreground"          Value="#52525B"/>
                <Setter Property="BorderThickness"     Value="1"/>
                <Setter Property="md:ButtonAssist.CornerRadius" Value="0"/>
                <Setter Property="FontSize"            Value="12"/>
                <Setter Property="FontFamily"          Value="{StaticResource AppFont}"/>
                <Setter Property="Height"              Value="28"/>
                <Setter Property="Padding"             Value="14 0"/>
            </Style>

            <!-- Destructive outlined -->
            <Style x:Key="DangerButton" TargetType="Button"
                   BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                <Setter Property="BorderBrush"         Value="#E4E4E7"/>
                <Setter Property="Foreground"          Value="#EF4444"/>
                <Setter Property="BorderThickness"     Value="1"/>
                <Setter Property="md:ButtonAssist.CornerRadius" Value="0"/>
                <Setter Property="FontSize"            Value="12"/>
                <Setter Property="FontFamily"          Value="{StaticResource AppFont}"/>
                <Setter Property="Height"              Value="28"/>
                <Setter Property="Padding"             Value="14 0"/>
            </Style>

            <!-- Icon-only small button -->
            <Style x:Key="IconButton" TargetType="Button"
                   BasedOn="{StaticResource MaterialDesignOutlinedButton}">
                <Setter Property="BorderBrush"         Value="#E4E4E7"/>
                <Setter Property="Foreground"          Value="#71717A"/>
                <Setter Property="BorderThickness"     Value="1"/>
                <Setter Property="md:ButtonAssist.CornerRadius" Value="0"/>
                <Setter Property="Width"               Value="28"/>
                <Setter Property="Height"              Value="28"/>
                <Setter Property="Padding"             Value="0"/>
            </Style>

            <!-- Sub-section sidebar nav button -->
            <Style x:Key="SubNavButton" TargetType="Button"
                   BasedOn="{StaticResource MaterialDesignFlatButton}">
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="HorizontalAlignment"        Value="Stretch"/>
                <Setter Property="Margin"                     Value="6 2"/>
                <Setter Property="Height"                     Value="40"/>
                <Setter Property="Padding"                    Value="14 0"/>
                <Setter Property="Background"                 Value="Transparent"/>
                <Setter Property="BorderThickness"            Value="0"/>
                <Setter Property="Foreground"                 Value="#52525B"/>
                <Setter Property="FontSize"                   Value="13"/>
                <Setter Property="FontWeight"                 Value="Normal"/>
                <Setter Property="FontFamily"                 Value="{StaticResource AppFont}"/>
                <Setter Property="md:ButtonAssist.CornerRadius" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#F5F3FF"/>
                        <Setter Property="Foreground" Value="#7C3AED"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Back nav button -->
            <Style x:Key="BackNavButton" TargetType="Button"
                   BasedOn="{StaticResource MaterialDesignFlatButton}">
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="HorizontalAlignment"        Value="Stretch"/>
                <Setter Property="Margin"                     Value="6 2"/>
                <Setter Property="Height"                     Value="38"/>
                <Setter Property="Padding"                    Value="14 0"/>
                <Setter Property="Background"                 Value="Transparent"/>
                <Setter Property="BorderThickness"            Value="0"/>
                <Setter Property="Foreground"                 Value="#EF4444"/>
                <Setter Property="FontSize"                   Value="13"/>
                <Setter Property="FontFamily"                 Value="{StaticResource AppFont}"/>
                <Setter Property="md:ButtonAssist.CornerRadius" Value="0"/>
            </Style>

            <!-- ══ SKELETON SHIMMER ══════════════════════════════════ -->
            <Style x:Key="SkeletonShimmer" TargetType="ContentControl">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <Grid ClipToBounds="True">
                                <Rectangle Fill="#EDE9FE"/>
                                <Rectangle Width="260">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Color="Transparent" Offset="0"/>
                                            <GradientStop Color="#70FFFFFF"   Offset="0.5"/>
                                            <GradientStop Color="Transparent" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                    <Rectangle.RenderTransform>
                                        <TranslateTransform x:Name="ShimmerX" X="-260"/>
                                    </Rectangle.RenderTransform>
                                    <Rectangle.Triggers>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard>
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="ShimmerX"
                                                                     Storyboard.TargetProperty="X"
                                                                     From="-260" To="1600" Duration="0:0:1.5"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Rectangle.Triggers>
                                </Rectangle>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
